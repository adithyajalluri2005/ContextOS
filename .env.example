# ContextOS settings. Copy the lines you need into your environment.
# ContextOS reads these only from environment variables and never saves them.

# Which AI service builds Context Packs: anthropic, openai, ollama, or fake (for tests).
CONTEXTOS_PROVIDER=

# Optional: a different model than the provider's default.
# Defaults: anthropic = claude-opus-5-5, openai = gpt-5, ollama = llama3.1 (gpt-oss:120b on Ollama's cloud)
CONTEXTOS_MODEL=

# Needed for the anthropic provider (pip install "contextos[anthropic]").
ANTHROPIC_API_KEY=

# Needed for the openai provider (pip install "contextos[openai]").
OPENAI_API_KEY=

# Optional: for Ollama's cloud service instead of a local Ollama. With a key set,
# requests go to https://ollama.com and the default model is gpt-oss:120b.
OLLAMA_API_KEY=

# Optional: where Ollama runs. Default: http://localhost:11434 (https://ollama.com with a key)
OLLAMA_HOST=

# Optional: where ContextOS keeps its database. Default: ~/.contextos
CONTEXTOS_HOME=
